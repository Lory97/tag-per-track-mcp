# ==============================================================================
# Tag-per-Track MCP Server - Environment Configuration Template
# ==============================================================================

# Private key of the paying wallet on Base (with USDC balance and ETH for gasless EIP-3009)
PRIVATE_KEY=0x...

# Target Tag-per-Track API endpoint URL
API_URL=https://api.tag-per-track.cloud/api/analyze

# Maximum spending cap per track in USDC units (e.g. 500000 = 0.50 USDC)
MAX_SPENDING_USDC=500000

# Pinned platform wallet recipient address (Defaults to 0xD33906178569f35EFF2E1665A14b06b455fF531F)
PLATFORM_WALLET=0xD33906178569f35EFF2E1665A14b06b455fF531F
